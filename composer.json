{
    "name": "rpn/rpn-website",
    "type": "project",
    "description": "Movie theater in Nogent-sur-Marne, France.",
    "keywords": [
        "movie theater",
        "website"
    ],
    "license": "MIT",
    "require": {
        "php": "^7.4.1",
        "ext-gd": "*",
        "ext-json": "*",
        "ext-redis": "*",
        "ext-simplexml": "*",
        "algolia/algoliasearch-client-php": "^2.6",
        "algolia/scout-extended": "^1.9",
        "fideloper/proxy": "^4.2",
        "fruitcake/laravel-cors": "^1.0",
        "gordesch/cine-carbon": "^1.2",
        "guzzlehttp/guzzle": "^6.0",
        "laracasts/flash": "^3.1",
        "laravel/framework": "^7.0",
        "laravel/horizon": "^4.0",
        "laravel/scout": "^8.0",
        "laravel/telescope": "^3.1",
        "laravel/tinker": "^2.2",
        "livewire/livewire": "^1.0",
        "spatie/laravel-medialibrary": "^8.0",
        "spatie/laravel-queueable-action": "^2.5",
        "van-ons/laraberg": "^1.0"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^2.6",
        "facade/ignition": "^2.0",
        "fruitcake/laravel-telescope-toolbar": "^1.2",
        "fzaninotto/faker": "^1.4",
        "laravel/ui": "^2.0",
        "mockery/mockery": "^1.3.1",
        "nunomaduro/collision": "^4.1",
        "nunomaduro/larastan": "^0.5.5",
        "nunomaduro/phpinsights": "^1.14",
        "phpunit/phpunit": "^9.0",
        "squizlabs/php_codesniffer": "3.5.3"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "platform": {
            "php": "7.4.1"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "classmap": [
            "database/seeds",
            "database/factories"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    }
}
